@model GameTracker.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Profil gracza";
}

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-body">
                <h3>@Model.Login</h3>
                <p class="text-muted">Rola: @Model.Role</p>
                <p>Łączna liczba punktów: <strong>@Model.TotalPoints</strong></p>
                <p>Rozegrane gry: <strong>@Model.GamesPlayed</strong></p>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Historia gier</h5>
            </div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Poziom</th>
                            <th>Punkty</th>
                            <th>Data</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.ScoreHistory.Any())
                        {
                            <tr>
                                <td colspan="3">Brak historii wyników.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var row in Model.ScoreHistory)
                            {
                                <tr>
                                    <td>@row.LevelName</td>
                                    <td>@row.Points</td>
                                    <td>@row.DateAchieved.ToString("yyyy-MM-dd HH:mm")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Odblokowane osiągnięcia</h5>
            </div>
            <div class="card-body">
                @if (!Model.Achievements.Any())
                {
                    <p>Brak odblokowanych osiągnięć.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var achievement in Model.Achievements)
                        {
                            <li class="list-group-item">
                                <strong>@achievement.Name</strong>
                                <div class="small text-muted">@achievement.Description</div>
                                <div class="small text-end">@achievement.UnlockedAt.ToString("yyyy-MM-dd")</div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
