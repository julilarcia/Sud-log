@model IEnumerable<GameTracker.Models.Achievement>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🏆 Zarządzanie Osiągnięciami (Odznaki)</h2>
        <a href="/Achievements/Create" class="btn btn-success">➕ Dodaj Nowe Osiągnięcie</a>
    </div>

    <table class="table table-striped shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nazwa Osiągnięcia</th>
                <th>Opis Wymagań</th>
                <th class="text-center">Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td><span class="badge bg-primary fs-6">🥇 @item.Name</span></td>
                    <td>@item.Description</td>
                    <td class="text-center">
                        <div class="d-flex justify-content-center gap-2">
                            <a href="/Achievements/Edit/@item.Id" class="btn btn-warning btn-sm">Edytuj</a>
                            <form action="/Achievements/Delete/@item.Id" method="post" onsubmit="return confirm('Usunąć to osiągnięcie?');">
                                <button type="submit" class="btn btn-danger btn-sm">Usuń</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>