@model GameTracker.Models.Achievement

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0">Ustawienia Osiągnięcia</h4>
            </div>
            <div class="card-body">
                <form method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-3">
                        <label class="form-label">Nazwa osiągnięcia (np. Wymiatacz):</label>
                        <input type="text" asp-for="Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Opis (np. Zdobądź 5000 punktów w jednej grze):</label>
                        <textarea asp-for="Description" class="form-control" rows="3" required></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success flex-grow-1">Zapisz</button>
                        <a href="/Achievements/Index" class="btn btn-secondary">Anuluj</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>