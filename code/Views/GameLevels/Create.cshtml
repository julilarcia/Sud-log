@model GameTracker.Models.GameLevel

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Dane Poziomu Gry</h4>
            </div>
            <div class="card-body">
                <form method="post">
                <div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-3">
                        <label class="form-label">Nazwa poziomu:</label>
                        <input type="text" asp-for="Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mnożnik punktów (np. 1,5):</label>
                        <input type="number" step="0.1" asp-for="DifficultyMultiplier" class="form-control" required />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success flex-grow-1">Zapisz</button>
                        <a href="/GameLevels/Index" class="btn btn-secondary">Anuluj</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>