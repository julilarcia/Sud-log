@model IEnumerable<GameTracker.ViewModels.UserListItemViewModel>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>👥 Zarządzanie Graczami</h2>
        <a asp-controller="Users" asp-action="Create" class="btn btn-success">➕ Dodaj nowego użytkownika</a>
    </div>

    <table class="table table-striped shadow-sm mt-3">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Login</th>
                <th>Rola</th>
                <th>Klucz API</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Id</td>
                    <td><strong>@user.Login</strong></td>
                    <td>@user.Role</td>
                    <td><code>@user.ApiKey</code></td>
                </tr>
            }
        </tbody>
    </table>
</div>